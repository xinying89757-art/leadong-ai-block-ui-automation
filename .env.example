# Copy to .env.local and fill locally. Never commit real credentials.
AIBLOCK_ADMIN_ACCOUNT=
AIBLOCK_ADMIN_PASSWORD=
# Legacy BUG1004949_ADMIN_ACCOUNT/PASSWORD names are still accepted as fallback.

# Optional external JSON file containing {"account":"...","password":"..."}.
# Leave empty when using the two environment variables above.
AIBLOCK_ADMIN_CONFIG=
# Legacy BUG1004949_ADMIN_CONFIG is still accepted as fallback.

# Optional persistent Playwright login state. Keep this file local.
UI_STORAGE_STATE=.auth/admin.storage.json

# The automation is configured to connect directly by default.
UI_PROXY=none

# Optional, only needed by visual fallback flows.
MIDSCENE_MODEL_API_KEY=
