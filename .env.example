# Copy to .env.local. Keep local credentials out of commits.
LEADONG_ADMIN_ACCOUNT=
LEADONG_ADMIN_PASSWORD=
# Deprecated AIBLOCK_* / BUG1004949_* names remain accepted as fallbacks.

# Optional external JSON file containing {"account":"...","password":"..."}.
# LEADONG_ADMIN_CONFIG takes precedence over deprecated fallback names.
LEADONG_ADMIN_CONFIG=

# Browser overrides. Empty channel or chromium uses Playwright's bundled Chromium.
LEADONG_BROWSER_CHANNEL=
# Optional browser channel override for the local browser test only.
LEADONG_TEST_BROWSER_CHANNEL=
# true/false or 1/0. CI=true defaults to headless + bundled Chromium.
LEADONG_HEADLESS=
# Non-negative integer milliseconds.
LEADONG_SLOW_MO=
# Optional local image override (absolute or repo-relative).
LEADONG_TEST_IMAGE=

# Optional persistent Playwright login state. Keep this file local.
UI_STORAGE_STATE=.auth/admin.storage.json
UI_PROXY=none
MIDSCENE_MODEL_API_KEY=
